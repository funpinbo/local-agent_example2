# 프로젝트 루트에 .env로 복사해서 쓴다. .env는 git에 올라가지 않는다.

# 2장: Notion MCP (선택). notion.so/profile/integrations에서 내부 통합을 만들고, 읽을 페이지에 연결(Connections)한다.
NOTION_TOKEN=

# 3장: 비서 → 그룹웨어 MCP 서버 서비스 키. 아무 긴 문자열이면 된다.
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(24))"
GROUPWARE_MCP_KEY=
